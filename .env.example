# Where the MCP server publishes videos (the Next.js site in this repo).
SITE_URL=http://localhost:3000
# Shared secret between the MCP server and the site's publish API.
PUBLISH_TOKEN=change-me
# Optional: Google API key with the Drive API enabled. Makes folder listing more robust
# (pagination, nested folders, exact mime types). Without it, public folders are read
# through Drive's embedded folder view.
GOOGLE_API_KEY=

# Development only: lets analyze_drive_folder read a folder on this machine instead of Drive.
# Leave unset in production, or a crafted "link" could publish any local folder.
# ALLOW_LOCAL_SOURCES=1
